<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's privacy manifest. Declares only what the shipped binary actually uses, established by
  inspecting the archived binary's imported symbols (nm -u), not by guessing:
  NSUserDefaults is the one "required reason" API present; stat/getattrlist/mach_absolute_time/
  disk-space/keyboard APIs are not. Re-check when adding a framework or a new system API.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: read/write info only accessible to the app itself (settings, watchlist). -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
