# Copy to .env and fill in. All values optional; sensible defaults apply.

# Fallback SEC User-Agent when the client does not forward one (SEC requires "Name email").
SEC_USER_AGENT="ValueLens Dev dev@example.com"

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html). Without it, default rates are used.
FRED_API_KEY=

# SQLite cache for EDGAR JSON (default: ./.cache/edgar.sqlite)
CACHE_DB=.cache/edgar.sqlite

# Licensed market prices (https://polygon.io, free tier is 5 req/min). Optional; Yahoo/Stooq fallback.
POLYGON_API_KEY=

# Hosted deployments: reject requests that don't carry a valid "Name email" identity.
REQUIRE_IDENTITY=false
# Requests per minute per client identity (0 = unlimited).
CLIENT_RATE_LIMIT_PER_MINUTE=60
