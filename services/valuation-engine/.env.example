# Copy to .env and fill in. All values optional; sensible defaults apply.

# Fallback SEC User-Agent when the client does not forward one (SEC requires "Name email").
SEC_USER_AGENT="ValueLens Dev dev@example.com"

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html). Without it, default rates are used.
FRED_API_KEY=

# Cache directory for EDGAR JSON (default: ./.cache)
CACHE_DIR=.cache
